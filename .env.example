# --- Model aliases (used by code) ---
# Change these to switch models without code changes
AI_MODEL_GENERATION=openai/gpt-oss-120b
AI_MODEL_EMBEDDINGS=openai/text-embedding-3-small

# Optional: Gateway base URL if needed (usually set by Vercel/Gateway config)
# Example (replace with your Gateway endpoint):
# AI_GATEWAY_URL=https://gateway.ai.vercel.com/api/v1

# --- Provider API Keys (for local dev) ---
# Set only what you use locally. In Vercel, store these as project-level encrypted envs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
VOYAGE_API_KEY=
MISTRAL_API_KEY=

# --- App config ---
# Enable/disable moderation (true/false)
RAG_ENABLE_MODERATION=true
# Similarity threshold to abstain (0..1)
RAG_SIMILARITY_THRESHOLD=0.72
# Retrieval top-k
RAG_TOP_K=5

# Return citations in API responses (UI Sources hidden by default)
# When false, citations are logged to telemetry only.
RAG_RETURN_CITATIONS=false

# Admin Console allowlist (comma-separated emails)
ADMIN_EMAILS=

# --- AUI / Redirect telemetry ---
# Public apex domain used for canonical brand routes
NEXT_PUBLIC_APEX_DOMAIN=hretheum.com
# If true (default), client beacon for redirect logging requires consent cookie below
NEXT_PUBLIC_REDIRECT_BEACON_REQUIRES_CONSENT=true
# Name of the consent cookie considered as analytics consent (value '1' or 'true')
NEXT_PUBLIC_CONSENT_COOKIE_NAME=hre_consent_analytics

# --- Redirect metrics thresholds (admin dashboard) ---
# p95 middleware time threshold (ms)
REDIRECT_MW_P95_THRESHOLD_MS=5
# correctness threshold (%)
REDIRECT_CORRECTNESS_THRESHOLD_PCT=99.9

# --- SEO / Indexing control ---
# Exact hostnames to mark as noindex (comma-separated), e.g.:
# NOINDEX_HOSTS=admin.hretheum.com,static.hretheum.com
# Reserved subdomains are auto noindex (www, app, admin, api, auth, static, cdn, assets, img, mail, ftp, m, stage, dev)

# --- E2E config (optional) ---
# Base URL for Playwright e2e (e.g., https://hretheum.com)
# REDIRECT_E2E_BASE=

# --- Vercel Drains (optional) ---
# Shared secret for Custom HTTP Drain (Authorization: Bearer <token>)
VERCEL_DRAIN_TOKEN=
# Error rate threshold (% of 5xx over total, evaluated from drain events)
REDIRECT_ERROR_RATE_THRESHOLD_PCT=0.1
