# Wymagane zmienne środowiskowe dla PROD (Vercel)
# Te zmienne trzeba ustawić w Vercel Dashboard → Project Settings → Environment Variables

# --- AI Models ---
AI_MODEL_GENERATION=gpt-4o-mini
AI_MODEL_EMBEDDINGS=text-embedding-3-small

# --- API Keys ---
OPENAI_API_KEY=sk-proj-... # Twój klucz z .env.local

# --- Suggested Queries (AUI) ---
NEXT_PUBLIC_RULES_CSR_SUGGESTED_QUERIES=true
NEXT_PUBLIC_RULES_AI_DEMO=true  # To było problemem!

# --- Follow-ups ---
NEXT_PUBLIC_RULES_AI_FOLLOWUPS=true
RULES_AI_FOLLOWUPS_ENABLED=true

# --- Basic config ---
NEXT_PUBLIC_APEX_DOMAIN=hretheum.com
NEXT_PUBLIC_ENABLE_GTM=true
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/hretheum/short-intro

# --- Consent ---
NEXT_PUBLIC_BEHAVIORAL_DEFAULT=allow
NEXT_PUBLIC_CONSENT_COOKIE_NAME=hre_consent_analytics