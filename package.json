{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run --reporter=default",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ingest": "npx tsx scripts/rag_ingest.ts",
    "ingest:supabase": "RAG_STORE=supabase npx tsx scripts/rag_ingest.ts",
    "validate:campaigns": "npx tsx scripts/validate_campaigns.ts",
    "lhci:mobile": "npx lhci autorun --config=lighthouserc.mobile.json",
    "lhci:desktop": "npx lhci autorun --config=lighthouserc.desktop.json",
    "lhci:all": "npm run lhci:mobile && npm run lhci:desktop"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.1.14",
    "@ai-sdk/openai-compatible": "^0.2.16",
    "@langchain/core": "^0.3.75",
    "@langchain/openai": "^0.6.11",
    "@mdx-js/mdx": "^3.0.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@swc/helpers": "^0.5.5",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "22.7.5",
    "@vercel/analytics": "^1.5.0",
    "ai": "^3.2.41",
    "autoprefixer": "10.4.20",
    "eslint": "^9.35.0",
    "eslint-config-next": "15.1.0",
    "gray-matter": "^4.0.3",
    "langchain": "^0.3.33",
    "next": "^15.5.3",
    "next-mdx-remote": "^5.0.0",
    "openai": "^4.58.1",
    "postcss": "8.4.47",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "3.4.10",
    "typescript": "5.6.3",
    "unified": "^11.0.5",
    "uuid": "^9.0.1",
    "web-vitals": "^4.2.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/config-array": "0.19.1",
    "@eslint/js": "9.17.0",
    "@eslint/object-schema": "2.1.5",
    "@lhci/cli": "^0.13.0",
    "@mermaid-js/mermaid-cli": "^11.9.0",
    "@playwright/test": "^1.48.0",
    "@types/react": "19.1.12",
    "vitest": "^2.0.5"
  }
